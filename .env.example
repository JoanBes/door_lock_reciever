# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real credentials. Required variables have no default and the
# app will crash with a KeyError on startup if they are missing.

# --- MQTT broker (HiveMQ Cloud) --- required
MQTT_BROKER=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=your-broker-username
MQTT_PASSWORD=your-broker-password

# Unique per running instance of server.py. If two processes (or two team
# members) use the same client id against the same broker, HiveMQ will
# disconnect one in favor of the other, causing a reconnect loop.
MQTT_CLIENT_ID=door-lock-server-yourname

# --- Web server --- optional (defaults shown)
HTTP_PORT=5000

# --- Flask session security --- optional
# If left unset, a random key is generated on first run and stored in
# data/.secret_key. Set this explicitly for a stable key across restarts
# (e.g. in a shared/demo deployment).
# SECRET_KEY=

# --- Database --- optional (defaults to data/door_lock.db)
# DB_PATH=data/door_lock.db

# --- Initial administrator account (used by `python db/init_db.py --seed`) ---
# optional — if unset, defaults to admin / admin1234 (change it!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_NAME=Administrator
